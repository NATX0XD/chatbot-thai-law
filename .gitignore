# ข้อมูลใหญ่ — ไม่ commit แต่ทำซ้ำได้ด้วยสคริปต์ใน ingest/
data/raw/
data/index/*
data/processed/*.jsonl
data/processed/*.csv

# ...ยกเว้นไฟล์ที่ตอนเสิร์ฟต้องใช้ Render build image จาก git จึงต้องมีใน repo
# (ต่ำกว่าลิมิต 100 MB ต่อไฟล์ของ GitHub ทุกไฟล์)
#
# corpus_ksp.jsonl คือคลังที่เสิร์ฟอยู่จริง 0.9 MB ถ้าไม่มีไฟล์นี้ ดัชนีที่ commit ไว้
# จะไม่มีข้อความให้ชี้ และ retriever จะล้มตอนเริ่มทำงานด้วย index/corpus mismatch
!data/processed/corpus_ksp.jsonl
!data/processed/corpus.jsonl
!data/index/vectors.npy
!data/index/bm25_compact.npz
!data/index/bm25_vocab.json

# bm25.pkl เป็นของ build เท่านั้น 31 MB และกินแรม 202 MB ตอนโหลด
data/index/bm25.pkl
