.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# ข้อมูลใหญ่ — ไม่ commit แต่ทำซ้ำได้ด้วยสคริปต์ใน ingest/
data/raw/
data/index/*
data/processed/*.jsonl
data/processed/*.csv

# ...ยกเว้นไฟล์ที่ตอนเสิร์ฟต้องใช้ Render build image จาก git จึงต้องมีใน repo
# (ต่ำกว่าลิมิต 100 MB ต่อไฟล์ของ GitHub ทุกไฟล์)
#
# corpus_ksp.jsonl คือคลังที่เสิร์ฟอยู่จริง 0.9 MB ถ้าไม่มีไฟล์นี้ ดัชนีที่ commit ไว้
# จะไม่มีข้อความให้ชี้ และ retriever จะล้มตอนเริ่มทำงานด้วย index/corpus mismatch
!data/processed/corpus_ksp.jsonl
!data/processed/corpus.jsonl
!data/index/vectors.npy
!data/index/bm25_compact.npz
!data/index/bm25_vocab.json

# คลังบทความวิชาการ 14 เรื่องและดัชนีของมัน ใช้ตอบเมื่อคำถามไม่ใช่เรื่องของตัวบท
# ลิขสิทธิ์เป็นของผู้เขียนและวารสาร ใช้ที่นี่เพื่อการศึกษา รายชื่อและที่มาอยู่ใน
# data/processed/corpus_articles_SOURCES.md
!data/processed/corpus_articles.jsonl
!data/index/articles_vectors.npy
!data/index/articles_bm25_compact.npz
!data/index/articles_bm25_vocab.json

# bm25.pkl เป็นของ build เท่านั้น 31 MB และกินแรม 202 MB ตอนโหลด
data/index/bm25.pkl

# คลังหนังสือคู่มือเรียนเครือข่ายคอมพิวเตอร์เบื้องต้นและดัชนีของมัน คือชุดข้อมูลที่บอทเสิร์ฟ
# อยู่ตอนนี้ (DATASET=network) Render build จาก git จึงต้องอยู่ใน repo
# ลิขสิทธิ์เป็นของบริษัท ซีเอ็ดยูเคชั่น จำกัด (มหาชน) ใช้ที่นี่เพื่อการศึกษา
# ที่มาอยู่ใน data/processed/corpus_network_SOURCES.md
# รูปที่ตัดจากหนังสืออยู่ใน web/figures/ ซึ่งไม่ได้ถูกกันไว้
!data/processed/corpus_network.jsonl
!data/index/network_vectors.npy
!data/index/network_bm25_compact.npz
!data/index/network_bm25_vocab.json
