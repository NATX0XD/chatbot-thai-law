# ---- Typhoon (ขอคีย์ฟรีที่ https://opentyphoon.ai) ----
TYPHOON_API_KEY=
# ค่าเริ่มต้นด้านล่างใช้ได้เลย แก้เฉพาะเมื่อ Typhoon เปลี่ยนชื่อรุ่น
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_FALLBACK_MODEL=typhoon-v2.1-12b-instruct

# ---- LINE Messaging API ----
# LINE Developers Console > ช่อง Messaging API ของคุณ
# Basic settings > Channel secret
LINE_CHANNEL_SECRET=
# Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ---- ปรับจูนการค้นคืน (ไม่ต้องแก้ก็ได้) ----
# ต่ำกว่านี้ถือว่าไม่พบตัวบทที่เกี่ยวข้อง ระบบจะตอบว่าไม่ทราบโดยไม่เรียก LLM
MIN_SCORE=0.020
TOP_K_FINAL=8

# ID ของบอทเอง ใช้ตรวจ @mention ในกลุ่ม — ดึงด้วย
#   curl -s https://api.line.me/v2/bot/info -H "Authorization: Bearer $TOKEN"
LINE_BOT_USER_ID=

# ---- Embeddings ----
# local = โหลด BGE-M3 ลงเครื่อง (ใช้ตอน build index และตอนรันในเครื่อง)
# api   = เรียก BGE-M3 checkpoint เดียวกันผ่าน endpoint แบบ OpenAI (ใช้ตอน deploy)
#
# ผู้ให้บริการที่ตรวจแล้ว: Cloudflare Workers AI @cf/baai/bge-m3
# วัด cosine เทียบโมเดลในเครื่องได้ 0.999999 จึงใช้ vectors.npy เดิมได้โดยไม่ต้อง rebuild
# ฟรี 10,000 neurons/วัน = ราว 9.3M tokens/วัน ไม่ต้องผูกบัตร
#
# ถ้าเปลี่ยนไปเจ้าอื่น ต้องรัน tests/test_embed_parity.py ให้ผ่านก่อนเสมอ
# ไม่งั้น cosine จะเลื่อนและเกณฑ์ min_dense_sim จะไม่ได้แปลว่าอะไรอีก
EMBED_BACKEND=local
# Account ID หาได้ที่ dash.cloudflare.com > Workers & Pages > แถบขวา
EMBED_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
EMBED_API_MODEL=@cf/baai/bge-m3
# สร้างที่ dash.cloudflare.com/profile/api-tokens สิทธิ์ Account > Workers AI > Read
EMBED_API_KEY=

# ---- ตัวสำรองชั้นที่สาม (เว้นว่างได้ ระบบจะข้ามไป) ----
# ใช้ต่อเมื่อ Typhoon ทั้งสองรุ่นล้ม ตั้งแล้วคำตอบบางข้ออาจไม่ได้มาจาก Typhoon
# ซึ่งมีผลต่อการรายงานผลในเล่ม — ตอนเก็บคำตอบเพื่อวัดผล ควรเว้นว่างไว้
GEMINI_API_KEY=

# ---- ดูข้อความที่เข้ามาแบบเรียลไทม์ ----
# เปิด GET /recent ซึ่งบอกว่าใครถามอะไร บอทตอบอะไร
# เว้นว่าง = ปลายทางปิด ตอบ 404 ตลอด ทั้งตอนไม่ใส่ token และตอนใส่ผิด
# ตั้งเองเป็นค่าอะไรก็ได้ที่เดายาก สุ่มด้วย  openssl rand -hex 16
# ต้องตรงกับตัวแปร monitorToken ใน postman/thai-law-bot.postman_collection.json
MONITOR_TOKEN=
