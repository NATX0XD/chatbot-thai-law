# ---- Typhoon (ขอคีย์ฟรีที่ https://opentyphoon.ai) ----
TYPHOON_API_KEY=
# ค่าเริ่มต้นด้านล่างใช้ได้เลย แก้เฉพาะเมื่อ Typhoon เปลี่ยนชื่อรุ่น
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_FALLBACK_MODEL=typhoon-v2.1-12b-instruct

# ---- LINE Messaging API ----
# LINE Developers Console > ช่อง Messaging API ของคุณ
# Basic settings > Channel secret
LINE_CHANNEL_SECRET=
# Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ---- ปรับจูนการค้นคืน (ไม่ต้องแก้ก็ได้) ----
# ต่ำกว่านี้ถือว่าไม่พบตัวบทที่เกี่ยวข้อง ระบบจะตอบว่าไม่ทราบโดยไม่เรียก LLM
MIN_SCORE=0.020
TOP_K_FINAL=6

# ID ของบอทเอง ใช้ตรวจ @mention ในกลุ่ม — ดึงด้วย
#   curl -s https://api.line.me/v2/bot/info -H "Authorization: Bearer $TOKEN"
LINE_BOT_USER_ID=

# ---- Embeddings ----
# local = โหลด BGE-M3 ลงเครื่อง (ใช้ตอน build index)
# api   = เรียก BGE-M3 ตัวเดียวกันผ่าน endpoint แบบ OpenAI (ใช้ตอน deploy)
EMBED_BACKEND=local
EMBED_BASE_URL=https://api.deepinfra.com/v1/openai
EMBED_API_MODEL=BAAI/bge-m3
EMBED_API_KEY=
