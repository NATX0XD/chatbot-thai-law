# keep the build context small: the raw sources alone are 383 MB and none of
# them are read at serving time
data/raw/
data/processed/*
# every COPY of data/processed/ in the Dockerfile needs a line here, or the file
# is not in the build context and the build stops at "file not found". This list
# and the COPY list are one thing in two places; change them together.
!data/processed/corpus_ksp.jsonl
!data/processed/corpus.jsonl
data/index/*
!data/index/vectors.npy
!data/index/bm25_compact.npz
!data/index/bm25_vocab.json

.venv/
.git/
__pycache__/
**/__pycache__/
*.pyc
report/
ingest/
tests/
scripts/
assets/
.env
*.pdf
*.docx
